
class Bar extends Foo {
	var foo: Foo = null;

	constructor Bar() {
		super();
	}

	func bar(): void {
		print("asdf\n");
	}

	func test(): void {
		print("test from bar!\n");
	}
}

class Foo {
	var bar: Bar = null;
	var num: int = 4;

	constructor Foo(){
		print("constructor from foo!\n");
	}
	
	func foo(): void {
		print("foo from foo!", num, "\n");
	}
}

class Base {
	var base: int = 1;

	constructor Base(value: int) {
		base = value;
	}

	func value(): int {
        base++;
        return base;
	}
}

class Child extends Base {
	var extra: int = 2;

	constructor Child(value: int){
		super(value);
	}

	func value(): int {
        print("extra", extra, "\n");
        extra--;
        print("extra", extra, "\n");
		return base * extra;
	}
}
