
func fibo(n: int, dp: array<int>): int{
    if(n <= 1){
        return 1;
    }

    if(dp[n] != -1){
        return dp[n];
    }
    
    var val: int = fibo(n - 1, dp) + fibo(n - 2, dp);
    dp[n] = val;

    return val;
}

func main(): void {
    var dp: array<int> = {};
    
    for(var i: int=0; i<100; i++){
        dp.push(-1);
    }

    fibo(10, dp);
}