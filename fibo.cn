
class Fibo {
    var dp: array<int> = {};

    constructor Fibo(){
        for(var i:int =0; i<40; i++){
            dp.push(-1);
        }
    }
    
    func fibo(n: int): int {
        if(n <= 1){
            return 1;
        }

        if(dp[n] != -1){
            return dp[n];
        }
        
        var val: int = fibo(n - 1) + fibo(n - 2);

        dp[n] = val;

        return val;
    }

}

func main(): void {
    var fibo: Fibo = new Fibo();
    
    for(var i:int =0; i<40; i++){
        print(fibo.fibo(i), "\n");
    }
}
