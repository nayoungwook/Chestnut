
func main(): void {
     print("Hello, World!\n");

     var td: int = 0;

     for(var i:int =0; i<=100; i++){
     	     print(i, "\n");
	     td += i;
     }

     var k: int = 3;
     var f: float = 3.5f;
     var sum: float = f + k;

     if(k == 3){
      	  print("K is three!\n");
     }else{
     	print("K is not three.\n");
     }

     print("Linux test\n");
     print(sum, "\n");
     print(td);
}