func log(value: string): void {
	print(value);
}

func exercise_numbers(seed: int): void {
	var i: int = seed;
	var sum: int = 0;
	var ratio: float = 2.0f;
	var precise: double = 3.5;

	i++;
	++i;
	i--;
	--i;

	sum = i + 3 * 2;
	ratio = 4.0f / 2.0f;
	precise = 1.5 + 2.0;

	if (sum >= 6 && i == seed) {
		log("number branch");
	} else if (sum != 0 || i < seed) {
		log("else-if branch");
	} else {
		log("else branch");
	}
}

func exercise_loop(): void {
	var i: int = 0;
	var total: int = 0;

	for (i = 0; i < 5; i++) {
		total = total + i;
	}

	log("loop done");
}

func exercise_objects(): void {
	var foo: Foo = null;
	var bar: Bar = null;

	bar.bar();
	bar.foo();
}

func main(): void {
	log("test start");
	exercise_numbers(0);
	exercise_loop();
	exercise_objects();
	log("test end");

	var test: array<int> = {2, 3, 4, 5};
	test = {1, 2, 3, 4};
	test[0] = 3;
	test.push(3);
}
